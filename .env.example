# Leave DATABASE_URL unset for local/offline SQLite mode. For production use PostgreSQL:
# DATABASE_URL=postgresql://fambeermconn:fambeermconn@localhost:5432/fambeermconn
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@fambeermconn.local
ADMIN_PASSWORD=ChangeMe!2026

# M-Pesa Daraja STK Push. Use sandbox credentials for testing.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-secret
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback/replace-with-a-long-random-secret

# Stripe Checkout and webhook. Create a webhook for checkout.session.completed
# and checkout.session.expired at https://your-domain.example/api/payments/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
